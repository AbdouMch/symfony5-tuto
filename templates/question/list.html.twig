{% extends 'base.html.twig' %}
{% block title %}Question List{% endblock %}
{% block body %}
    <div class="container mt-3">
        {% if is_granted('IS_VERIFIED') %}
            <div class="row mb-3">
                <div class="col">
                    <a class="btn btn-question" href="{{ path('app_question_create') }}">Ask a Question</a>
                    {% if is_granted('ROLE_QUESTIONS_EXPORT') %}
                        <a class="btn btn-question" href="{{ path('app_questions_download') }}">Export list</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <form method="get" class="mb-3 d-flex">
            <input type="text" name="title[contains]" class="form-control mr-2"
                   placeholder="Search questions…"
                   value="{{ app.request.query.all.title.contains ?? '' }}">
            <button type="submit" class="btn btn-primary">Search</button>
        </form>

        {% include 'question/questions_show.html.twig' with { questions: result.result } %}

        {% include 'components/_pagination.html.twig' with { result: result } %}
    </div>
{% endblock %}
